# 可在设置 → API 与模型中完成配置。使用环境文件时，将此模板复制为本机 .env。
# AI_PROVIDER 填 gemini 或 compatible。
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_FIGURE_MODEL=
AI_API_KEY=
PORT=4317

# 可选。默认使用项目 .venv，否则使用 PATH 中的 Python。
# PAPER_DOWNLOAD_PYTHON=/absolute/path/to/python
# PAPER_DOWNLOAD_SKILL=/absolute/path/to/download_paper.py
# OPENALEX_API_KEY=
# NCBI 请求可读取 HTTP_PROXY、HTTPS_PROXY 和 NO_PROXY。

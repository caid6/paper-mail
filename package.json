{
  "name": "paper-morning",
  "productName": "Paper-mail",
  "version": "2.17.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "desktop:dev": "npm run build && electron .",
    "desktop:dir": "node scripts/assert-platform.mjs darwin && npm run build && node scripts/build-pdf-runtime.mjs && electron-builder --mac dir",
    "desktop:dist": "npm run desktop:dir && node scripts/make-dmg.mjs",
    "desktop:dir:win": "node scripts/assert-platform.mjs win32 && npm run build && node scripts/build-pdf-runtime.mjs && electron-builder --win dir --x64 --publish never",
    "desktop:dist:win": "node scripts/assert-platform.mjs win32 && npm run build && node scripts/build-pdf-runtime.mjs && electron-builder --win nsis --x64 --publish never",
    "test": "node scripts/test.mjs",
    "setup:python": "node scripts/setup-python.mjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tsx": "^4.20.0",
    "undici": "^7.30.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "com.caid6.papermail",
    "productName": "Paper-mail",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "**/*",
      "!build/pdf-runtime/**/*"
    ],
    "extraResources": [
      {
        "from": "build/pdf-runtime",
        "to": "pdf-runtime"
      }
    ],
    "asarUnpack": [
      "scripts/**/*.mjs",
      "scripts/**/*.py",
      "requirements.txt",
      "node_modules/@esbuild/**"
    ],
    "mac": {
      "icon": "assets/paper-mail.icns",
      "category": "public.app-category.medical",
      "identity": null,
      "target": [
        "dmg"
      ],
      "artifactName": "Paper-mail-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/paper-mail.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Paper-mail-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
